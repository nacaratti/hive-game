{
  "name": "hive-pro",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev": "npm run build -w @hive/client && npm run dev -w @hive/server",
    "dev:client": "npm run dev -w @hive/client",
    "dev:server": "npm run dev -w @hive/server",
    "build": "npm run build -w @hive/client",
    "desktop": "npm run build -w @hive/client && npm run start -w @hive/desktop",
    "dist": "npm run dist -w @hive/desktop",
    "train": "tsx packages/ai/scripts/train.ts",
    "arena": "tsx packages/ai/scripts/arena.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "tsx": "^4.19.2"
  }
}