{
  "name": "@hive/desktop",
  "productName": "Favo",
  "version": "0.2.0",
  "private": true,
  "description": "Favo: jogue com amigos hospedando a partida no seu PC",
  "author": "Favo",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build -w @hive/client --prefix ../.. && npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@hive/server": "*",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "app.favo.desktop",
    "productName": "Favo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client"
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Favo"
    },
    "electronVersion": "33.4.11",
    "electronDist": "../../node_modules/electron/dist"
  }
}